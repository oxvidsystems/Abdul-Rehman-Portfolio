# STEP 11 — lead storage. Copy to .env.local and fill in.
#
# .env.local is git-ignored. Never commit real values, and never give any of
# these the NEXT_PUBLIC_ prefix — that prefix is what tells Next.js to inline
# a value into the JavaScript the browser downloads. Everything below is
# read only inside /api/leads, which runs on the server.

# ---- Firebase service account (Project settings > Service accounts > Generate key)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the whole key including the BEGIN/END lines. If your host stores it on
# one line, leave the \n sequences in — the code converts them back.
FIREBASE_PRIVATE_KEY=

# ---- Abuse protection
# Any long random string. Peppers the SHA-256 of the requester's IP so the
# rate-limit counters can't be reversed back to addresses.
# Generate one with:  openssl rand -hex 32
RATE_LIMIT_SALT=

# ---- Origin check
# The site's own public URL, e.g. https://oxvidsystems.com
NEXT_PUBLIC_SITE_URL=

# ---- Verification codes (Step 12)
# Keys the HMAC that hashes each 6-digit code before storage. A plain hash of
# a 6-digit code is worthless — a million guesses is under a second — so this
# secret is what actually protects them. Must be at least 32 characters; the
# app refuses to start verification without it rather than falling back to an
# unkeyed hash.
# Generate with:  openssl rand -hex 32
VERIFICATION_PEPPER=

# ---- Sending the verification email
# Resend (https://resend.com) — an API key and a verified sender domain.
# Swapping to Postmark/SendGrid/Mailgun means changing one function in
# src/lib/leads/mailer.ts. Sending through your own oxvidsystems mailbox is
# SMTP and needs nodemailer — a deliberate choice, not a default.
RESEND_API_KEY=
LEAD_FROM_EMAIL="OXVID Systems <info@oxvidsystems.com>"

# ---- Local development only
# Writes the verification email to .mail-outbox/ instead of sending it, so the
# flow can be tested without a provider account. The app THROWS if this is set
# while NODE_ENV=production — it puts live codes on disk.
# LEAD_DEV_OUTBOX=1

# ---- Owner notification (Step 13)
# Where the "new verified lead" email goes. Defaults to info@oxvidsystems.com
# if unset, so this only needs a value to send somewhere else.
# LEAD_NOTIFY_EMAIL=info@oxvidsystems.com
