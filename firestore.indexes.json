{
  "indexes": [
    {
      "//": "Newest verified leads first — the query a lead view will run.",
      "collectionGroup": "leads",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "qualified", "order": "ASCENDING" },
        { "fieldPath": "verifiedAt", "order": "DESCENDING" }
      ]
    },
    {
      "//": "Everything by status, newest first — for triaging pending/expired.",
      "collectionGroup": "leads",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "verificationStatus", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    }
  ],
  "fieldOverrides": []
}
