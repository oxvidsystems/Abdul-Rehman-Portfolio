rules_version = '2';

/**
 * STEP 11 — Firestore security rules.
 *
 * Deny everything, to every client SDK, on every path.
 *
 * This looks drastic and is exactly right for this app. The only writer is
 * the Firebase Admin SDK inside /api/leads, and the Admin SDK authenticates
 * as a service account, which bypasses these rules entirely. So denying all
 * client access costs nothing and closes the whole surface: no browser, no
 * mobile SDK and no leaked web API key can read a lead, list the collection,
 * enumerate ids, or write a forged one.
 *
 * The alternative — letting browsers write leads under a shape rule — was
 * rejected on purpose. Rules can check that a field is a string of a certain
 * length; they cannot normalise a phone number, classify a project type
 * against a list, apply a rate limit, or guarantee `emailVerified` is false.
 * The brief requires server-side validation, and that means a server.
 *
 * Step 12 adds a `verifications` collection holding hashed codes. It is
 * covered by the same blanket deny, which matters more there than anywhere:
 * those documents gate whether a lead counts as verified, and nothing
 * outside the server has any business reading or touching them.
 *
 * Deploy with:  firebase deploy --only firestore:rules
 * Verify after deploying — an un-deployed rules file protects nothing.
 */
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
